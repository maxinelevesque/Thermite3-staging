fn transitive_diverging(x: u64) -> u64
  ! diverge
  requires true
  ensures result == x
{ transitive_diverging(x) }

fn diverge_middle(x: u64) -> u64
  ! diverge
  requires true
  ensures result == x
{ transitive_diverging(x) }

fn transitive_diverge_root(x: u64) -> u64
  ! diverge
  requires true
  ensures result == x
{ diverge_middle(x) }
