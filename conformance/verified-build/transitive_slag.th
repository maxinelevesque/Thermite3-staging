#[slag(reason = "test crossing", owner = "thermite", review = "required")]
fn transitive_vendored(x: u64) -> u64
  ! pure
  requires true
  ensures result == x
{ x }

fn slag_middle(x: u64) -> u64
  ! pure
  requires true
  ensures result == x
{ transitive_vendored(x) }

fn transitive_slag_root(x: u64) -> u64
  ! pure
  requires true
  ensures result == x
{ slag_middle(x) }
