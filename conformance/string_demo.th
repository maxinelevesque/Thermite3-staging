fn greeting_len(s: String) -> u64
  ! pure
  requires true
  ensures result == s.len()
{
  s.len()
}

fn first_byte(s: String) -> u64
  ! pure
  requires s.len() > 0
  ensures result == s.byte_at(0)
{
  s.byte_at(0)
}

fn join(a: String, b: String) -> String
  ! alloc
  requires a.len() + b.len() <= 1_000_000
  ensures result.len() == a.len() + b.len()
{
  a.concat(b)
}

fn literal_len() -> u64
  ! alloc
  requires true
  ensures result == 5
{
  "hello".len()
}
