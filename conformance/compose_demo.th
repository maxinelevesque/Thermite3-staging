fn step_inc(x: u32) -> u32
  ! pure
  requires x < 99
  ensures result == x + 1
{
  x + 1
}

fn step_double(y: u32) -> u32
  ! pure
  requires y < 100
  ensures result == 2 * y
{
  2 * y
}

fn pipeline(x: u32) -> u32
  ! pure
  requires x < 99
  ensures result == 2 * (x + 1)
{
  step_double(step_inc(x))
}

#[boundary("os::read_small")] fn read_small() -> Option<u64>
  ! read(stdin)
  requires true
  ensures match result {
    Some(v) => v < 256,
    None    => true,
  }
  ;

fn read_then_inc() -> Option<u64>
  ! read(stdin)
  requires true
  ensures match result {
    Some(v) => v < 257,
    None    => true,
  }
{
  match read_small() {
    Some(v) => Some(v + 1),
    None    => None,
  }
}
