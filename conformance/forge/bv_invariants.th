// Tagged invariants use fixed-width values inside the ordinary Verus invariant VC.
// The first loop invariant wraps; the second asks Verus to prove that its addition
// cannot wrap. Both remain visible as bv_shadow records in the certificate.

struct Word {
    bits: u64,
    amount: u64
} keeps@bv8 bits + amount == amount + bits

fn advance(start: u64) -> u64
    ! pure
    requires start <= 3
    ensures result == 3
{
    let mut i: u64 = start;
    while i < 3
        keeps i <= 3
        keeps@bv8 i + 255 == i - 1
        keeps@bv8(nowrap) i + 1 <= 4
        measures 3 - i
    {
        i = i + 1;
    }
    i
}
