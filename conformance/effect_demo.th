shared stdin: u8

#[boundary("os::read_small")] fn read_small() -> Option<u64>
  ! read(stdin)
  requires true
  ensures match result {
    Some(v) => v < 256,
    None    => true,
  }
  ;

#[boundary("os::now")] fn now() -> Option<u64>
  ! time
  requires true
  ensures match result {
    Some(t) => t < 4_000_000_000,
    None    => true,
  }
  ;

fn read_doubled() -> Option<u64>
  ! read(stdin)
  requires true
  ensures match result {
    Some(v) => v < 512,
    None    => true,
  }
{
  match read_small() {
    Some(v) => Some(v + v),
    None    => None,
  }
}
