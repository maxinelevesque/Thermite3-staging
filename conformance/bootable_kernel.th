#[sealed] struct Clock { slot: u64 }

struct Instant {
  ticks: u64,
  scale_numerator: u64,
  scale_denominator: u64,
  error_ticks: u64
}
  keeps scale_numerator > 0 && scale_denominator > 0

#[boundary("kernel::clock::read@v1")]
fn clock_read(clock: Clock) -> Instant
  ! platform(clock)
  requires true
  ensures result.scale_numerator > 0
  ensures result.scale_denominator > 0
;

fn kernel_step(clock: Clock) -> u64
  ! platform(clock)
  requires true
  ensures result > 0
{
  clock_read(clock).scale_denominator
}
