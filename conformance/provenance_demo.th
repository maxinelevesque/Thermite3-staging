shared db: u8
shared log: u8

struct Tainted { raw: u64 }
#[sealed] struct Sql { stmt: u64 }

#[boundary("ifc::parameterize")] fn parameterize(t: Tainted) -> Sql
  ! pure
  requires true
  ensures result.stmt == t.raw
  ;

#[boundary("ifc::query")] fn query(q: Sql) -> u64
  ! net(db)
  requires true
  ensures result == q.stmt
  ;

fn safe_query(input: Tainted) -> u64
  ! net(db)
  requires true
  ensures result == input.raw
{
  query(parameterize(input))
}

fn careless_query(input: Tainted) -> u64
  ! net(db)
  requires true
  ensures result == input.raw
{
  query(input)
}

struct Secret { val: u64 }
#[sealed] struct Public { val: u64 }

#[boundary("ifc::declassify")] fn declassify(s: Secret) -> Public
  ! pure
  requires true
  ensures result.val == s.val
  ;

#[boundary("ifc::emit")] fn emit(p: Public) -> u64
  ! write(log)
  requires true
  ensures result == p.val
  ;

fn safe_emit(s: Secret) -> u64
  ! write(log)
  requires true
  ensures result == s.val
{
  emit(declassify(s))
}

fn leak(s: Secret) -> u64
  ! write(log)
  requires true
  ensures result == s.val
{
  emit(s)
}

struct User { id: u64 }
#[sealed] struct Authorized { id: u64 }

#[boundary("ifc::authorize")] fn authorize(u: User) -> Authorized
  ! pure
  requires true
  ensures result.id == u.id
  ;

#[boundary("ifc::delete")] fn delete(c: Authorized) -> u64
  ! write(db)
  requires true
  ensures result == c.id
  ;

fn safe_delete(u: User) -> u64
  ! write(db)
  requires true
  ensures result == u.id
{
  delete(authorize(u))
}

fn unauth_delete(u: User) -> u64
  ! write(db)
  requires true
  ensures result == u.id
{
  delete(u)
}
