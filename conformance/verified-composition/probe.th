struct ProbeState {
  owner: u64,
  generation: u64,
  payload: Vec<u64>,
}

enum ProbeEvent {
  Tick(u64),
  Idle,
}

enum ProbeAction {
  Store { owner: u64, generation: u64, slot: u64, value: u64 },
  Noop,
}

fn probe_step(state: ProbeState, event: ProbeEvent) -> (ProbeState, ProbeAction)
  ! pure
  requires state.generation < 18_446_744_073_709_551_615
  ensures result.0.owner == state.owner
  ensures result.0.generation == state.generation + 1
  ensures result.0.payload.len() == state.payload.len()
  ensures match event {
    ProbeEvent::Tick(expected) => match result.1 {
      ProbeAction::Store { owner, generation, slot, value } =>
        owner == state.owner &&
        generation == state.generation + 1 &&
        slot == state.generation &&
        value == expected,
      ProbeAction::Noop => false,
    },
    ProbeEvent::Idle => match result.1 {
      ProbeAction::Store { owner, generation, slot, value } => false,
      ProbeAction::Noop => true,
    },
  }
{
  match event {
    ProbeEvent::Tick(value) => (
      ProbeState {
        owner: state.owner,
        generation: state.generation + 1,
        payload: state.payload,
      },
      ProbeAction::Store {
        owner: state.owner,
        generation: state.generation + 1,
        slot: state.generation,
        value: value,
      },
    ),
    ProbeEvent::Idle => (
      ProbeState {
        owner: state.owner,
        generation: state.generation + 1,
        payload: state.payload,
      },
      ProbeAction::Noop,
    ),
  }
}
