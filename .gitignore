# === Crosslink managed (do not edit between markers) ===
# .crosslink/ — machine-local state (never commit)
.crosslink/issues.db
.crosslink/issues.db-wal
.crosslink/issues.db-shm
.crosslink/agent.json
.crosslink/session.json
.crosslink/daemon.pid
.crosslink/daemon.log
.crosslink/last_test_run
.crosslink/.active-issue
.crosslink/keys/
.crosslink/.hub-cache/
.crosslink/.knowledge-cache/
.crosslink/.cache/
.crosslink/init-manifest.json
.crosslink/init-manifest.json.tmp
.crosslink/hook-config.local.json
.crosslink/integrations/
.crosslink/rules.local/

# .crosslink/ — DO track these (project-level policy):
#   .crosslink/hook-config.json   — shared team configuration
#   .crosslink/rules/             — project coding standards
#   .crosslink/.gitignore         — inner gitignore for agent files

# .claude/ — auto-generated by crosslink init (not project source)
.claude/hooks/
.claude/commands/
.claude/mcp/

# .claude/ — DO track these (if manually configured):
#   .claude/settings.json         — Claude Code project settings
#   .claude/settings.local.json is per-developer, ignore separately if needed
# === End crosslink managed ===

# ACToR harness read-state (per-worktree)
.crosslink/.spec-reads.json
gates/__pycache__/
__pycache__/

# Rust build artifacts
target/

# Stray per-crate crosslink caches (hooks invoked from a crate cwd create these;
# the crosslink-managed block above only anchors the repo-root .crosslink/.cache/)
**/.crosslink/.cache/
.crosslink/.last-hydrated-ref

# User-level skill copies (not project source; like .claude/hooks above, these
# are environment-provided — the harness-critical .claude/agents/ ARE tracked).
.claude/skills/

# Crosslink runtime signing key (machine-local; trust is synced via the hub branch).
.crosslink/driver-key.pub
examples/editor/bin/

# Lean 4 build directory (the verified-validator metatheory; lean/, #170). `.lake/`
# is Lake's build output (compiled .olean + the package manifest) — a build artifact,
# never committed; the lean-toolchain pin + lakefile.toml reproduce it.
lean/.lake/
binary_search_golden

# crosslink kickoff agent-id marker (per-worktree, must not be committed)
.kickoff-session

# kan local log and derived index. The shareable signed form is .claims/, tracked.
.kan/

# day disposable render cache (display only).
.day/

# built by dev/thermite3-migrate
dev/thermite3-migrate/target/

# === RFC-15: materialized opt-in stacks ===
# `just use <stack>` copies these from opt-in/ into the working tree. They are
# listed here so they stop being tracked at RFC-15 step 3; until then the tracked
# copies at the root still exist and git ignores nothing already tracked, so
# these lines are inert. Adding them at step 1 means step 3 is a `git rm` with no
# further ignore work, and it documents which paths are generated.
/.mcp.json
/.claude/settings.json
/.claude/agents/
/.crosslink/hook-config.json
/.crosslink/rules/
